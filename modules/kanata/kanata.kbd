;; sudo ln -sf ~/.dotfiles/compositors/kanata/kanata.kbd /etc/kanata.kbd

(defcfg
  process-unmapped-keys no
  macos-dev-names-exclude (
    "HP 435 Wireless Mouse"
  )
)

(defsrc
  ;; --- modifiers ---
  caps lalt

  ;; --- disabled ---
  home end  grv  -    =

  ;; --- right hand ---
  u    i    o
  h    j    k    l    ;
  y    p
)

(deflayer default
  ;; --- modifiers ---
  esc  @nav

  ;; --- disabled ---
  XX   XX   XX   XX   XX

  ;; --- right hand ---
  u    i    o
  h    j    k    l    ;
  y    p
)

(deflayer navigation
  ;; --- modifiers ---
  _    _

  ;; --- disabled ---
  XX   XX   XX   XX   XX

  ;; --- right hand ---
  grv  -    =
  left down up   rght lmet
  home end
)

(defalias
  nav (layer-while-held navigation)
)
