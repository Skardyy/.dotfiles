;; sudo ln -sf ~/.dotfiles/compositors/kanata/kanata.kbd /etc/kanata.kbd

(defcfg
  process-unmapped-keys no
  macos-dev-names-exclude (
    "HP 435 Wireless Mouse"
  )
)

(defsrc
  ;; --- modifiers ---
  caps lalt

  ;; --- disabled ---
  grv  -    =    [    ]

  ;; --- right hand ---
  u    i    o
  h    j    k    l    ;
  n    m    ,    /

  ;; --- left hand (numpad) ---
  q    w    e
  a    s    d    f
  z    x    c
)

(deflayer default
  ;; --- modifiers ---
  esc  @nav

  ;; --- disabled ---
  XX   XX   XX   XX   XX

  ;; --- right hand ---
  u    i    o
  h    j    k    l    ;
  n    m    ,    /

  ;; --- left hand (numpad) ---
  q    w    e
  a    s    d    f
  z    x    c
)

(deflayer navigation
  ;; --- modifiers ---
  _    _

  ;; --- disabled ---
  XX   XX   XX   XX   XX

  ;; --- right hand ---
  grv  -    =
  left down up   rght lmet
  home [    ]    end

  ;; --- left hand (numpad) ---
  7    8    9
  4    5    6    0
  1    2    3
)

(defalias
  nav (layer-while-held navigation)
)
