;; sudo ln -sf ~/.dotfiles/compositors/kanata/kanata.kbd /etc/kanata.kbd

(defcfg
  process-unmapped-keys no
  macos-dev-names-exclude (
    "HP 435 Wireless Mouse"
  )
)

(defsrc
  ;; --- modifiers ---
  caps lalt

  ;; --- disabled ---
  home end  grv  -    =

  ;; --- right hand ---
  u    i    o
  h    j    k    l    ;
  n    m

  ;; --- left hand (numpad) ---
  q    w    e    r    t
  a    s    d    f    g
)

(deflayer default
  ;; --- modifiers ---
  esc  @nav

  ;; --- disabled ---
  XX   XX   XX   XX   XX

  ;; --- right hand ---
  u    i    o
  h    j    k    l    ;
  n    m

  ;; --- left hand (numpad) ---
  q    w    e    r    t
  a    s    d    f    g
)

(deflayer navigation
  ;; --- modifiers ---
  _    _

  ;; --- disabled ---
  XX   XX   XX   XX   XX

  ;; --- right hand ---
  grv  -    =
  left down up   rght lmet
  home end

  ;; --- left hand (numpad) ---
  1    2    3    4    5
  0    9    8    7    6
)

(defalias
  nav (layer-while-held navigation)
)
