;; sudo ln -sf ~/.dotfiles/compositors/kanata/kanata.kbd /etc/kanata.kbd

(defcfg
  process-unmapped-keys no
  macos-dev-names-exclude (
    "HP 435 Wireless Mouse"
  )
)

(defsrc
  caps lalt
  a    s    d    f    g
  u    i    o    p
  h    j    k    l
  n    m    ,    .    /
)

(deflayer default
  esc  @alt_nav
  a    s    d    f    g
  u    i    o    p
  h    j    k    l
  n    m    ,    .    /
)

(deflayer navigation
  _          _
  @1_nav     @2_nav    @3_nav    @4_nav    @5_nav
  @grv_nav   @min_nav  @eql_nav  @bs_nav
  @left_nav  @down_nav @up_nav   @rght_nav
  @6_nav     @7_nav    @8_nav    @9_nav    @0_nav
)

(defalias
  alt_nav  (multi lalt (layer-while-held navigation))
  left_nav (multi (release-key lalt) left)
  down_nav (multi (release-key lalt) down)
  up_nav   (multi (release-key lalt) up)
  rght_nav (multi (release-key lalt) rght)
  grv_nav  (multi (release-key lalt) grv)
  min_nav  (multi (release-key lalt) -)
  eql_nav  (multi (release-key lalt) =)
  bs_nav   (multi (release-key lalt) bspc)
  1_nav    (multi (release-key lalt) 1)
  2_nav    (multi (release-key lalt) 2)
  3_nav    (multi (release-key lalt) 3)
  4_nav    (multi (release-key lalt) 4)
  5_nav    (multi (release-key lalt) 5)
  6_nav    (multi (release-key lalt) 6)
  7_nav    (multi (release-key lalt) 7)
  8_nav    (multi (release-key lalt) 8)
  9_nav    (multi (release-key lalt) 9)
  0_nav    (multi (release-key lalt) 0)
)
