;; sudo ln -sf ~/.dotfiles/compositors/kanata/kanata.kbd /etc/kanata.kbd

(defcfg
  process-unmapped-keys no
  macos-dev-names-exclude (
    "HP 435 Wireless Mouse"
  )
)

(defsrc
  ;; --- modifiers ---
  caps lalt

  ;; --- disabled ---
  home end  grv  -    =

  ;; --- top row ---
  y    u    i    o    p

  ;; --- home row ---
  h    j    k    l

  ;; --- thumb ---
  spc
)

(deflayer default
  ;; --- modifiers ---
  esc  @nav

  ;; --- disabled ---
  XX   XX   XX   XX   XX

  ;; --- top row ---
  y    u    i    o    p

  ;; --- home row ---
  h    j    k    l

  ;; --- thumb ---
  spc
)

(deflayer navigation
  ;; --- modifiers ---
  _    _

  ;; --- disabled ---
  XX   XX   XX   XX   XX

  ;; --- top row ---
  home grv  -    =    end

  ;; --- home row ---
  left down up   rght

  ;; --- thumb: cmd ---
  lmet
)

(defalias
  nav (layer-while-held navigation)
)
