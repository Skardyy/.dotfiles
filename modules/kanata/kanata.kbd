;; sudo ln -sf ~/.dotfiles/compositors/kanata/kanata.kbd /etc/kanata.kbd

(defcfg
  process-unmapped-keys no
  macos-dev-names-exclude (
    "HP 435 Wireless Mouse"
  )
)

(defsrc
  caps lalt
  grv  -    =    [    ]
  u    i    o
  h    j    k    l    ;    '
  n    m
)

(deflayer default
  esc  @alt_nav
  XX   XX   XX   XX   XX
  u    i    o
  h    j    k    l    ;    '
  n    m
)

(deflayer navigation
  _          _
  XX         XX        XX        XX        XX
  @grv_nav   @min_nav  @eql_nav
  @left_nav  @down_nav @up_nav   @rght_nav @lbrc_nav @rbrc_nav
  @home_nav  @end_nav
)

(defalias
  alt_nav  (multi lalt (layer-while-held navigation))
  left_nav (multi (release-key lalt) left)
  down_nav (multi (release-key lalt) down)
  up_nav   (multi (release-key lalt) up)
  rght_nav (multi (release-key lalt) rght)
  lbrc_nav (multi (release-key lalt) [)
  rbrc_nav (multi (release-key lalt) ])
  grv_nav  (multi (release-key lalt) grv)
  min_nav  (multi (release-key lalt) -)
  eql_nav  (multi (release-key lalt) =)
  home_nav (multi (release-key lalt) home)
  end_nav  (multi (release-key lalt) end)
)
